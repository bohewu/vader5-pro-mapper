# Device profiles and local diagnostics can contain device IDs or local paths.
/backups/
/logs/
/work/
*.bin
*.log
*.dmp
*.tmp

# Machine-specific runtime overrides and private configuration.
*.local.cmd
*.local.ps1
*.local.json
.env
.env.*
!.env.example

# Dependencies are resolved locally, never redistributed.
*.dll
*.exe
*.pdb

# Editor and operating-system files.
.vs/
.vscode/
*.suo
*.user
Thumbs.db
Desktop.ini
.DS_Store
